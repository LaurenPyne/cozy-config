FROM docker.io/library/rust:latest

RUN apt-get update && \
    apt-get install -y \
        git \
        just \
        ripgrep \
        curl \
        pkg-config \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 developer

USER developer

WORKDIR /workspace

CMD ["bash"]
